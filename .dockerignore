# Réduit fortement le contexte Docker. Tout ce qui n'est pas indispensable
# au build est ignoré pour accélérer COPY et limiter les fuites accidentelles.
.git
.github
.husky
node_modules
**/node_modules

# Dists workspace : seul `apps/pii-scanner-web/dist/browser/` est
# nécessaire au runtime nginx (cf. Dockerfile mono-stage v1.0.3+). Les
# dists des packages workspace ne servent qu'au build TypeScript local
# et n'ont rien à faire dans le contexte Docker. ATTENTION : ne PAS
# remettre `**/dist` global ici, ça exclurait le dist Angular qui est la
# raison d'être du build Docker (cf. release v1.0.2 où le mauvais
# .dockerignore avait obligé l'ancien Dockerfile à rebuilder sous QEMU
# arm64, d'où l'« illegal instruction » crash).
packages/*/dist
apps/pii-scanner-web/dist/server
apps/pii-scanner-web/dist/server.mjs

**/.angular
**/coverage
.DS_Store
*.log
.env
.env.*
.idea
.vscode

# Fichiers de session
COMMIT_MSG_*.txt
TAG_MSG_*.txt

# Documentation hors site (les .md utiles sont déjà copiés au besoin)
historique/
sandbox/
