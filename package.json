{
  "name": "pii-scanner-web-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo pii-scanner-web : détecteurs (lib pure), engine (orchestration), application Angular.",
  "license": "AGPL-3.0-only",
  "author": "Rudy Rezaire <contact@rezdevops.com> (RezDevOps)",
  "homepage": "https://github.com/RezDevOps/pii-scanner-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RezDevOps/pii-scanner-web.git"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build && pnpm --filter pii-scanner-web build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,scss,json,md}\"",
    "dev": "pnpm --filter pii-scanner-web start",
    "clean": "pnpm -r exec rm -rf dist .angular coverage",
    "prepare": "husky install"
  },
  "devDependencies": {
    "happy-dom": "^20.9.0",
    "husky": "^8.0.0",
    "prettier": "^3.3.3",
    "typescript": "~5.9.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.0.0",
      "happy-dom": "^20.0.0",
      "fast-uri": ">=3.1.2",
      "ip-address": ">=10.1.1"
    },
    "auditConfig": {
      "ignoreCves": []
    }
  }
}
