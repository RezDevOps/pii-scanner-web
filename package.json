{
  "name": "pii-scanner-web-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo pii-scanner-web : détecteurs (lib pure), engine (orchestration), application Angular.",
  "license": "AGPL-3.0-only",
  "author": "Rudy Rezaire <contact@rezdevops.com> (RezDevOps)",
  "homepage": "https://github.com/RezDevOps/pii-scanner-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RezDevOps/pii-scanner-web.git"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build && pnpm --filter pii-scanner-web build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,scss,json,md}\"",
    "dev": "pnpm --filter pii-scanner-web start",
    "clean": "pnpm -r exec rm -rf dist .angular coverage",
    "prepare": "husky install"
  },
  "devDependencies": {
    "happy-dom": "^20.9.0",
    "husky": "^8.0.0",
    "prettier": "^3.3.3",
    "typescript": "~5.9.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.0.0",
      "happy-dom": "^20.0.0",
      "fast-uri": ">=3.1.2",
      "ip-address": ">=10.1.1",
      "shell-quote": ">=1.8.4",
      "undici@>=6.0.0 <7.0.0": ">=6.27.0",
      "undici@>=7.0.0": ">=7.28.0",
      "ws": ">=8.21.0",
      "vite": ">=7.3.5",
      "hono": ">=4.12.25",
      "http-proxy-middleware": ">=3.0.7",
      "piscina": ">=5.2.0",
      "sigstore": ">=4.1.1",
      "esbuild": ">=0.28.1",
      "@babel/core": ">=7.29.6",
      "webpack-dev-server": ">=5.2.5",
      "qs": ">=6.15.2",
      "launch-editor": ">=2.14.1",
      "brace-expansion@>=5.0.0 <6.0.0": ">=5.0.6",
      "js-yaml@>=4.0.0 <5.0.0": ">=4.2.0",
      "tar@>=7.0.0 <8.0.0": ">=7.5.16"
    },
    "auditConfig": {
      "ignoreCves": []
    }
  }
}
