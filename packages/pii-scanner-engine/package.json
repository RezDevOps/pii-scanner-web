{
  "name": "@rezdevops/pii-scanner-engine",
  "version": "1.0.2",
  "description": "Orchestration de scan PII : parseurs CSV / XLSX / PDF / TXT / JSON / DOCX / HTML (binaires lazy-loadés), pool de Web Workers, agrégation des findings, génération des exports JSON / Markdown / HTML autonome.",
  "license": "AGPL-3.0-only",
  "author": "Rudy Rezaire <r.rezaire@gmail.com> (RezDevOps)",
  "homepage": "https://github.com/RezDevOps/pii-scanner-web/tree/main/packages/pii-scanner-engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RezDevOps/pii-scanner-web.git",
    "directory": "packages/pii-scanner-engine"
  },
  "bugs": {
    "url": "https://github.com/RezDevOps/pii-scanner-web/issues"
  },
  "keywords": [
    "pii",
    "rgpd",
    "gdpr",
    "scanner",
    "csv",
    "xlsx",
    "pdf",
    "web-worker"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/scan-worker.d.ts",
      "import": "./dist/worker/scan-worker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@rezdevops/pii-detectors": "workspace:*",
    "comlink": "^4.4.2",
    "mammoth": "^1.8.0",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^4.7.76"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15",
    "happy-dom": "^20.0.0"
  },
  "engines": {
    "node": ">=20.10"
  }
}
