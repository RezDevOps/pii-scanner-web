  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "echo \"(tests Jest viendront en S1 avec les premiers détecteurs)\" && exit 0",
    "lint": "echo \"(eslint configuré en S1)\" && exit 0",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20.10"
  }
