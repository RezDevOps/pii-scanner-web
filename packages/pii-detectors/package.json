{
  "name": "@rezdevops/pii-detectors",
  "version": "0.0.0",
  "description": "Détecteurs déterministes de données à caractère personnel (PII) — bibliothèque pure, sans I/O ni DOM. Validation par clé de contrôle pour NIR, SIRET, IBAN, TVA intracom, carte bancaire.",
  "license": "AGPL-3.0-only",
  "author": "Rudy Rezaire <r.rezaire@gmail.com> (RezDevOps)",
  "homepage": "https://github.com/RezDevOps/pii-scanner-web/tree/main/packages/pii-detectors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RezDevOps/pii-scanner-web.git",
    "directory": "packages/pii-detectors"
  },
  "bugs": {
    "url": "https://github.com/RezDevOps/pii-scanner-web/issues"
  },
  "keywords": [
    "pii",
    "rgpd",
    "gdpr",
    "nir",
    "iban",
    "siret",
    "luhn",
    "mod-97",
    "data-protection",
    "france"
  ],
  "type": "module",
