{
  "name": "@rezdevops/pii-detectors",
  "version": "1.1.0",
  "description": "Détecteurs déterministes de données à caractère personnel (PII) — bibliothèque pure, sans I/O ni DOM. 12 détecteurs : email, téléphone FR, NIR, IBAN, BIC, SIRET, TVA intracom FR, carte bancaire (Luhn), code postal FR, plaque immat FR, date de naissance, adresse postale FR.",
  "license": "AGPL-3.0-only",
  "author": "Rudy Rezaire <contact@rezdevops.com> (RezDevOps)",
  "homepage": "https://github.com/RezDevOps/pii-scanner-web/tree/main/packages/pii-detectors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RezDevOps/pii-scanner-web.git",
    "directory": "packages/pii-detectors"
  },
  "bugs": {
    "url": "https://github.com/RezDevOps/pii-scanner-web/issues"
  },
  "keywords": [
    "pii",
    "rgpd",
    "gdpr",
    "nir",
    "iban",
    "siret",
    "luhn",
    "mod-97",
    "data-protection",
    "france"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20.10"
  }
}
